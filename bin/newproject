#!/bin/sh
# newproject <name> [--here] [--dir <path>] [--no-open]
# newproject --update          refresh this project's kit files from the installed template
# newproject --self-update     pull the latest kit and reinstall
#
# Updates are automatic: the kit checks for a new version at most once a day, and
# every kit project updates itself when Claude starts in it. CLAUDE_KIT_NO_AUTO_UPDATE=1
# turns that off.
#
# Creates a project that is ready to build: git repo, .claude/ harness, verify
# script, CI. Then opens Claude Code and asks you for the idea.
set -eu

KIT_HOME="${CLAUDE_KIT_HOME:-$HOME/.claude-kit}"
BASE="${NEWPROJECT_DIR:-$HOME/Projects}"
NAME=""; HERE=0; OPEN="${NEWPROJECT_NO_OPEN:+0}"; OPEN="${OPEN:-1}"
MODE="create"; QUIET=0

while [ $# -gt 0 ]; do
  case "$1" in
    --here)        HERE=1; shift ;;
    --dir)         BASE="$2"; shift 2 ;;
    --no-open)     OPEN=0; shift ;;
    --update)      MODE="update"; shift ;;
    --self-update) MODE="self-update"; shift ;;
    --auto-update) MODE="auto-update"; shift ;;   # internal: daily, silent
    --quiet)       QUIET=1; shift ;;
    --version)     cat "$KIT_HOME/VERSION" 2>/dev/null || echo "unknown"; exit 0 ;;
    -h|--help)
      sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "newproject: unknown option $1" >&2; exit 2 ;;
    *)  NAME="$1"; shift ;;
  esac
done

kit_version() { cat "$KIT_HOME/VERSION" 2>/dev/null || echo "unknown"; }

# ---------------------------------------------------------------- self-update
# Pull the kit's git checkout and reinstall when it moved. "auto" runs at most once a
# day, silently, and never touches a checkout that is dirty or not on main.
self_update() {
  SRC=$(cat "$KIT_HOME/.source" 2>/dev/null || true)
  if [ -z "$SRC" ] || [ ! -d "$SRC/.git" ]; then
    [ "$1" = auto ] && return 0
    echo "newproject: no git checkout recorded at $KIT_HOME/.source" >&2
    echo "  clone the kit again and run its install.sh" >&2
    exit 1
  fi
  if [ "$1" = auto ]; then
    [ -z "${CLAUDE_KIT_NO_AUTO_UPDATE:-}" ] || return 0
    now=$(date +%s); last=$(cat "$KIT_HOME/.last-check" 2>/dev/null || echo 0)
    [ $((now - last)) -ge 86400 ] || return 0
    echo "$now" > "$KIT_HOME/.last-check"
    [ "$(git -C "$SRC" branch --show-current 2>/dev/null)" = main ] || return 0
    [ -z "$(git -C "$SRC" status --porcelain 2>/dev/null)" ] || return 0
    GIT_TERMINAL_PROMPT=0 git -C "$SRC" -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=15 \
      pull -q --ff-only >/dev/null 2>&1 || return 0
    [ "$(git -C "$SRC" rev-parse HEAD)" = "$(cat "$KIT_HOME/.commit" 2>/dev/null)" ] && return 0
  else
    echo "pulling $SRC"
    git -C "$SRC" pull --ff-only
  fi
  sh "$SRC/install.sh" >/dev/null
}

if [ "$MODE" = "auto-update" ]; then
  self_update auto
  exit 0
fi

if [ "$MODE" = "self-update" ]; then
  OLD=$(kit_version)
  self_update manual
  NEW=$(kit_version)
  if [ "$OLD" = "$NEW" ]; then
    echo "already on $NEW"
  else
    echo "kit $OLD -> $NEW — projects update themselves the next time Claude starts in them"
  fi
  exit 0
fi

# --------------------------------------------------------------- update a project
if [ "$MODE" = "update" ]; then
  [ -d .claude ] || { echo "newproject --update: run this inside a project created by the kit" >&2; exit 1; }
  [ -d "$KIT_HOME/template" ] || { echo "newproject: template not found at $KIT_HOME/template" >&2; exit 1; }

  [ "$QUIET" = 1 ] || self_update auto
  FROM=$(cat .claude/KIT_VERSION 2>/dev/null || echo "unknown")
  TO=$(kit_version)

  # Only the kit's own machinery is refreshed, and only the pieces the kit ships.
  # Your own skills, agents, hooks and settings stay. Anything /kickoff writes or you
  # edit is left alone: CLAUDE.md, docs/, work/, IDEA.md, scripts/verify.sh, and
  # .github/workflows/verify.yml all keep your project's version.
  for d in skills agents hooks; do
    mkdir -p ".claude/$d"
    for src in "$KIT_HOME/template/.claude/$d"/*; do
      [ -e "$src" ] || continue
      n=$(basename "$src")
      rm -rf ".claude/$d/$n"
      cp -R "$src" ".claude/$d/$n"
    done
  done

  # settings.json is merged, not replaced: the kit's keys win, yours are kept.
  # `ask` rules are dropped — the kit never shows a permission prompt.
  if [ ! -f .claude/settings.json ]; then
    cp "$KIT_HOME/template/.claude/settings.json" .claude/settings.json
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "$KIT_HOME/template/.claude/settings.json" .claude/settings.json <<'PY'
import json, sys
kit = json.load(open(sys.argv[1]))
path = sys.argv[2]
proj = json.load(open(path))
KIT_HOOK = ".claude/hooks/state.sh"
for key, val in kit.items():
    if key == "permissions":
        perms = proj.setdefault("permissions", {})
        perms.update(val)
        perms.pop("ask", None)
    elif key == "env":
        proj.setdefault("env", {}).update(val)
    elif key == "hooks":
        hooks = proj.setdefault("hooks", {})
        for event, groups in val.items():
            yours = [g for g in hooks.get(event, [])
                     if not any(KIT_HOOK in h.get("command", "") for h in g.get("hooks", []))]
            hooks[event] = yours + groups
    else:
        proj[key] = val
with open(path, "w") as f:
    json.dump(proj, f, indent=2)
    f.write("\n")
PY
  else
    echo "newproject: python3 not found — .claude/settings.json was not merged" >&2
  fi

  mkdir -p scripts
  for s in check-config.sh tag-release.sh ship-loop.sh; do
    cp "$KIT_HOME/template/scripts/$s" "scripts/$s" 2>/dev/null || true
  done
  chmod +x scripts/*.sh .claude/hooks/*.sh 2>/dev/null || true
  # Loop runtime state must never be committed.
  for p in work/.shipping work/.ship-loop.log work/BLOCKED.md; do
    grep -qxF "$p" .gitignore 2>/dev/null || echo "$p" >> .gitignore
  done
  echo "$TO" > .claude/KIT_VERSION

  [ "$QUIET" = 1 ] && exit 0
  echo "updated $FROM -> $TO"
  echo "  refreshed: the kit's skills, agents and hooks; settings.json (merged);"
  echo "             scripts/check-config.sh, scripts/tag-release.sh, scripts/ship-loop.sh"
  echo "  kept:      your own skills, agents, hooks and settings"
  echo "  untouched: CLAUDE.md, docs/, work/, IDEA.md, scripts/verify.sh, .github/workflows/"
  exit 0
fi

# --------------------------------------------------------------------- create
self_update auto
[ -n "$NAME" ] || { echo "usage: newproject <name> [--here] [--dir <path>] [--no-open]" >&2; exit 2; }
[ -d "$KIT_HOME/template" ] || {
  echo "newproject: template not found at $KIT_HOME/template" >&2
  echo "  set CLAUDE_KIT_HOME, or re-run the kit's install.sh" >&2
  exit 1; }

if [ "$HERE" -eq 1 ]; then DEST="$PWD"; else DEST="$BASE/$NAME"; fi
if [ -e "$DEST" ] && [ "$HERE" -eq 0 ]; then
  echo "newproject: $DEST already exists" >&2; exit 1
fi

mkdir -p "$DEST"
cd "$DEST"

cp -R "$KIT_HOME/template/." .
chmod +x scripts/*.sh .claude/hooks/*.sh 2>/dev/null || true
kit_version > .claude/KIT_VERSION

if [ -f CLAUDE.md ]; then
  sed '1s|^# Project instructions$|# '"$NAME"'|' CLAUDE.md > CLAUDE.md.tmp && mv CLAUDE.md.tmp CLAUDE.md
fi

# The scaffold commit happens here, in plain shell, before any agent runs.
if [ ! -d .git ]; then
  git init -b main -q
  git add -A
  git commit -q -m "chore: initialize project from claude-agentic-workflow-starter-kit"
fi

echo "created $DEST"
echo
echo "  claude will ask you for the idea, then /kickoff takes it from there."
echo

[ "$OPEN" = 1 ] || exit 0
command -v claude >/dev/null 2>&1 || { echo "claude not on PATH; open it yourself and run /kickoff."; exit 0; }
exec claude "This is a brand new, empty project. There is no IDEA.md yet and nothing has been described to you. Your first message must ask me to describe the project I want to build: what it is, who it is for, and anything I already know about scope or stack. Ask that and nothing else, then wait. Do not read files, do not explore, do not plan, do not run /kickoff yet. When I answer, write what I said verbatim into IDEA.md, then run /kickoff."
