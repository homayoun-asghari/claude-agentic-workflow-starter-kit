#!/bin/sh
# newproject <name> [--here] [--dir <path>] [--no-open]
# newproject --update          refresh this project's kit files from the installed template
# newproject --self-update     pull the latest kit and reinstall
#
# Creates a project that is ready to build: git repo, .claude/ harness, verify
# script, CI. Then opens Claude Code and asks you for the idea.
set -eu

KIT_HOME="${CLAUDE_KIT_HOME:-$HOME/.claude-kit}"
BASE="${NEWPROJECT_DIR:-$HOME/Projects}"
NAME=""; HERE=0; OPEN="${NEWPROJECT_NO_OPEN:+0}"; OPEN="${OPEN:-1}"
MODE="create"

while [ $# -gt 0 ]; do
  case "$1" in
    --here)        HERE=1; shift ;;
    --dir)         BASE="$2"; shift 2 ;;
    --no-open)     OPEN=0; shift ;;
    --update)      MODE="update"; shift ;;
    --self-update) MODE="self-update"; shift ;;
    --version)     cat "$KIT_HOME/VERSION" 2>/dev/null || echo "unknown"; exit 0 ;;
    -h|--help)
      sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "newproject: unknown option $1" >&2; exit 2 ;;
    *)  NAME="$1"; shift ;;
  esac
done

kit_version() { cat "$KIT_HOME/VERSION" 2>/dev/null || echo "unknown"; }

# ---------------------------------------------------------------- self-update
if [ "$MODE" = "self-update" ]; then
  SRC=$(cat "$KIT_HOME/.source" 2>/dev/null || true)
  [ -n "$SRC" ] && [ -d "$SRC/.git" ] || {
    echo "newproject: no git checkout recorded at $KIT_HOME/.source" >&2
    echo "  clone the kit again and run its install.sh" >&2
    exit 1; }
  OLD=$(kit_version)
  echo "pulling $SRC"
  git -C "$SRC" pull --ff-only
  sh "$SRC/install.sh" >/dev/null
  NEW=$(kit_version)
  if [ "$OLD" = "$NEW" ]; then
    echo "already on $NEW"
  else
    echo "kit $OLD -> $NEW"
    echo "run 'newproject --update' inside each project to pick it up"
  fi
  exit 0
fi

# --------------------------------------------------------------- update a project
if [ "$MODE" = "update" ]; then
  [ -d .claude ] || { echo "newproject --update: run this inside a project created by the kit" >&2; exit 1; }
  [ -d "$KIT_HOME/template" ] || { echo "newproject: template not found at $KIT_HOME/template" >&2; exit 1; }

  FROM=$(cat .claude/KIT_VERSION 2>/dev/null || echo "unknown")
  TO=$(kit_version)

  # Only the kit's own machinery is refreshed. Anything /kickoff writes or you
  # edit is left alone: CLAUDE.md, docs/, work/, IDEA.md, scripts/verify.sh,
  # and .github/workflows/verify.yml all keep your project's version.
  rm -rf .claude/skills .claude/agents .claude/hooks
  cp -R "$KIT_HOME/template/.claude/skills" .claude/skills
  cp -R "$KIT_HOME/template/.claude/agents" .claude/agents
  cp -R "$KIT_HOME/template/.claude/hooks" .claude/hooks
  cp "$KIT_HOME/template/.claude/settings.json" .claude/settings.json
  for s in check-config.sh release.sh ship-loop.sh; do
    cp "$KIT_HOME/template/scripts/$s" "scripts/$s" 2>/dev/null || true
  done
  chmod +x scripts/*.sh .claude/hooks/*.sh 2>/dev/null || true
  # Loop runtime state must never be committed.
  for p in work/.shipping work/.ship-loop.log work/BLOCKED.md; do
    grep -qxF "$p" .gitignore 2>/dev/null || echo "$p" >> .gitignore
  done
  echo "$TO" > .claude/KIT_VERSION

  echo "updated $FROM -> $TO"
  echo "  refreshed: .claude/skills, .claude/agents, .claude/hooks, .claude/settings.json,"
  echo "             scripts/check-config.sh, scripts/release.sh, scripts/ship-loop.sh"
  echo "  untouched: CLAUDE.md, docs/, work/, IDEA.md, scripts/verify.sh, .github/workflows/"
  exit 0
fi

# --------------------------------------------------------------------- create
[ -n "$NAME" ] || { echo "usage: newproject <name> [--here] [--dir <path>] [--no-open]" >&2; exit 2; }
[ -d "$KIT_HOME/template" ] || {
  echo "newproject: template not found at $KIT_HOME/template" >&2
  echo "  set CLAUDE_KIT_HOME, or re-run the kit's install.sh" >&2
  exit 1; }

if [ "$HERE" -eq 1 ]; then DEST="$PWD"; else DEST="$BASE/$NAME"; fi
if [ -e "$DEST" ] && [ "$HERE" -eq 0 ]; then
  echo "newproject: $DEST already exists" >&2; exit 1
fi

mkdir -p "$DEST"
cd "$DEST"

cp -R "$KIT_HOME/template/." .
chmod +x scripts/*.sh .claude/hooks/*.sh 2>/dev/null || true
kit_version > .claude/KIT_VERSION

if [ -f CLAUDE.md ]; then
  sed '1s|^# Project instructions$|# '"$NAME"'|' CLAUDE.md > CLAUDE.md.tmp && mv CLAUDE.md.tmp CLAUDE.md
fi

# The scaffold commit happens here, in plain shell, before any agent runs.
if [ ! -d .git ]; then
  git init -b main -q
  git add -A
  git commit -q -m "chore: initialize project from claude-agentic-workflow-starter-kit"
fi

echo "created $DEST"
echo
echo "  claude will ask you for the idea, then /kickoff takes it from there."
echo

[ "$OPEN" = 1 ] || exit 0
command -v claude >/dev/null 2>&1 || { echo "claude not on PATH; open it yourself and run /kickoff."; exit 0; }
exec claude "This is a brand new, empty project. There is no IDEA.md yet and nothing has been described to you. Your first message must ask me to describe the project I want to build: what it is, who it is for, and anything I already know about scope or stack. Ask that and nothing else, then wait. Do not read files, do not explore, do not plan, do not run /kickoff yet. When I answer, write what I said verbatim into IDEA.md, then run /kickoff."
