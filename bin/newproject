#!/bin/sh
# newproject <name> [--here] [--dir <path>] [--no-open]
# newproject --update          refresh this project's kit files from the installed template
# newproject --self-update     pull the latest kit and reinstall
# newproject --adopt           put an existing repo on the kit (keeps all its own files)
# newproject --enable-auto-adopt
#                              every code repo under ~/Projects adopts the kit the first
#                              time Claude starts in it (adds one global SessionStart hook)
#
# Updates are automatic: the kit checks for a new version at most once a day, and
# every kit project updates itself when Claude starts in it. CLAUDE_KIT_NO_AUTO_UPDATE=1
# turns that off.
#
# Creates a project that is ready to build: git repo, .claude/ harness, verify
# script, CI. Then opens Claude Code and asks you for the idea.
set -eu

KIT_HOME="${CLAUDE_KIT_HOME:-$HOME/.claude-kit}"
BASE="${NEWPROJECT_DIR:-$HOME/Projects}"
NAME=""; HERE=0; OPEN="${NEWPROJECT_NO_OPEN:+0}"; OPEN="${OPEN:-1}"
MODE="create"; QUIET=0

while [ $# -gt 0 ]; do
  case "$1" in
    --here)        HERE=1; shift ;;
    --dir)         BASE="$2"; shift 2 ;;
    --no-open)     OPEN=0; shift ;;
    --update)      MODE="update"; shift ;;
    --self-update) MODE="self-update"; shift ;;
    --auto-update) MODE="auto-update"; shift ;;   # internal: daily, silent
    --adopt)       MODE="adopt"; shift ;;
    --adopt-hook)  MODE="adopt-hook"; shift ;;    # internal: global SessionStart hook
    --enable-auto-adopt) MODE="enable-auto-adopt"; shift ;;
    --quiet)       QUIET=1; shift ;;
    --version)     cat "$KIT_HOME/VERSION" 2>/dev/null || echo "unknown"; exit 0 ;;
    -h|--help)
      sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "newproject: unknown option $1" >&2; exit 2 ;;
    *)  NAME="$1"; shift ;;
  esac
done

kit_version() { cat "$KIT_HOME/VERSION" 2>/dev/null || echo "unknown"; }

# ---------------------------------------------------------------- self-update
# Pull the kit's git checkout and reinstall when it moved. "auto" runs at most once a
# day, silently, and never touches a checkout that is dirty or not on main.
self_update() {
  SRC=$(cat "$KIT_HOME/.source" 2>/dev/null || true)
  if [ -z "$SRC" ] || [ ! -d "$SRC/.git" ]; then
    [ "$1" = auto ] && return 0
    echo "newproject: no git checkout recorded at $KIT_HOME/.source" >&2
    echo "  clone the kit again and run its install.sh" >&2
    exit 1
  fi
  if [ "$1" = auto ]; then
    [ -z "${CLAUDE_KIT_NO_AUTO_UPDATE:-}" ] || return 0
    now=$(date +%s); last=$(cat "$KIT_HOME/.last-check" 2>/dev/null || echo 0)
    [ $((now - last)) -ge 86400 ] || return 0
    echo "$now" > "$KIT_HOME/.last-check"
    [ "$(git -C "$SRC" branch --show-current 2>/dev/null)" = main ] || return 0
    [ -z "$(git -C "$SRC" status --porcelain 2>/dev/null)" ] || return 0
    GIT_TERMINAL_PROMPT=0 git -C "$SRC" -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=15 \
      pull -q --ff-only >/dev/null 2>&1 || return 0
    [ "$(git -C "$SRC" rev-parse HEAD)" = "$(cat "$KIT_HOME/.commit" 2>/dev/null)" ] && return 0
  else
    echo "pulling $SRC"
    git -C "$SRC" pull --ff-only
  fi
  sh "$SRC/install.sh" >/dev/null
}

if [ "$MODE" = "auto-update" ]; then
  self_update auto
  exit 0
fi

if [ "$MODE" = "self-update" ]; then
  OLD=$(kit_version)
  self_update manual
  NEW=$(kit_version)
  if [ "$OLD" = "$NEW" ]; then
    echo "already on $NEW"
  else
    echo "kit $OLD -> $NEW — projects update themselves the next time Claude starts in them"
  fi
  exit 0
fi

# ------------------------------------------------------------- adopt an existing repo
# The kit's machinery goes in; nothing the project already has is overwritten. Files
# the project lacks (verify.sh, CI, CLAUDE.md) come from the template and are then
# fitted to the real stack by Claude — the adopt-hook tells it so.
if [ "$MODE" = "adopt" ]; then
  top=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "newproject --adopt: not inside a git repo" >&2; exit 1; }
  cd "$top"
  [ -d "$KIT_HOME/template" ] || { echo "newproject: template not found at $KIT_HOME/template" >&2; exit 1; }
  if [ -f .claude/KIT_VERSION ]; then
    [ "$QUIET" = 1 ] || echo "already on the kit ($(cat .claude/KIT_VERSION)) — use --update"
    exit 0
  fi
  T="$KIT_HOME/template"
  # Never write through a symlink: every path the kit writes must stay inside the repo.
  for p in .claude .claude/skills .claude/agents .claude/hooks .claude/settings.json scripts scripts/verify.sh \
           .github .github/workflows .github/workflows/verify.yml CLAUDE.md work docs .gitignore; do
    [ -L "$p" ] && { echo "newproject --adopt: $p is a symlink; refusing to write through it" >&2; exit 1; }
  done
  ADDED=""
  add() {  # add <path>: copy from the template only if the project has none
    [ -e "$1" ] && return 0
    mkdir -p "$(dirname "$1")"; cp -R "$T/$1" "$1"; ADDED="$ADDED $1"
  }
  add CLAUDE.md
  add scripts/verify.sh
  add .github/workflows/verify.yml
  add work/README.md
  mkdir -p .claude docs
  "$0" --update --quiet || { echo "newproject --adopt: kit update step failed" >&2; exit 1; }
  touch .gitignore
  for p in node_modules/ .env '.env*.local' '*.pem'; do
    grep -qxF "$p" .gitignore || echo "$p" >> .gitignore
  done
  date -u +%Y-%m-%dT%H:%MZ > .claude/KIT_ADOPTED
  [ "$QUIET" = 1 ] && exit 0
  echo "adopted the kit $(kit_version) in $top"
  echo "  added from the template:${ADDED:- (nothing — the project had them all)}"
  echo "  next: fit scripts/verify.sh and the CI toolchain to this project's real stack,"
  echo "        then commit on chore/adopt-workflow-kit and open a PR"
  exit 0
fi

# ----------------------------------------------------- global SessionStart: auto-adopt
# Silent unless it adopts. Only real code repos under $BASE; never the kit itself.
if [ "$MODE" = "adopt-hook" ]; then
  [ -z "${CLAUDE_KIT_NO_AUTO_ADOPT:-}" ] || exit 0
  dir=${CLAUDE_PROJECT_DIR:-$PWD}
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || exit 0
  base=$(cd "$BASE" 2>/dev/null && pwd -P) || exit 0
  case "$(cd "$top" && pwd -P)" in "$base"/*) ;; *) exit 0 ;; esac
  [ -f "$top/.claude/KIT_VERSION" ] || [ -f "$top/.claude/NO_KIT" ] && exit 0
  [ -f "$top/template/.claude/settings.json" ] && [ -f "$top/bin/newproject" ] && exit 0
  code=$(find "$top" -maxdepth 4 \( -name node_modules -o -name .git -o -name .venv -o -name venv -o -name vendor \) -prune -o \
    -type f \( -name package.json -o -name pyproject.toml -o -name requirements.txt -o -name Cargo.toml -o -name go.mod \
    -o -name foundry.toml -o -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.py' -o -name '*.sol' -o -name '*.go' \
    -o -name '*.rs' -o -name '*.swift' -o -name '*.kt' \) -print 2>/dev/null | head -1)
  [ -n "$code" ] || exit 0
  # Only the user's own repos: no remote, or an origin owned by the kit's own GitHub owner
  # (or one listed in CLAUDE_KIT_ADOPT_OWNERS, space separated).
  origin=$(git -C "$top" remote get-url origin 2>/dev/null || true)
  if [ -n "$origin" ]; then
    kitsrc=$(cat "$KIT_HOME/.source" 2>/dev/null || true)
    me=$(git -C "$kitsrc" remote get-url origin 2>/dev/null | sed -E 's#^.*github\.com[:/]([^/]+)/.*$#\1#')
    owner=$(echo "$origin" | sed -E 's#^.*github\.com[:/]([^/]+)/.*$#\1#')
    ok=0
    for o in $me ${CLAUDE_KIT_ADOPT_OWNERS:-}; do [ "$owner" = "$o" ] && ok=1; done
    [ "$ok" = 1 ] || exit 0
  fi
  (cd "$top" && "$0" --adopt --quiet) >/dev/null 2>&1 || exit 0
  cat <<EOF
## Workflow kit: this project was just put on the claude-agentic-workflow-starter-kit ($(kit_version))

Its machinery (.claude/ skills, agents, hooks, settings; scripts/merge.sh, tag-release.sh,
check-config.sh, ship-loop.sh) is now in the working tree, uncommitted. Nothing the project
already had was overwritten. To opt a repo out, create .claude/NO_KIT instead.

Keep the adoption in its own branch and PR, separate from the user's request:
1. Branch chore/adopt-workflow-kit from the default branch.
2. Rewrite scripts/verify.sh for this project's REAL stack: the format, lint, typecheck, test
   and build commands that actually exist here. Make it pass. Fit the toolchain setup in
   .github/workflows/verify.yml (only if it was added now). If CLAUDE.md was added now, fill
   in "What this is" and the real dev/test/build commands from the code.
3. Commit, PR, hands-on check, ./scripts/merge.sh.

From now on every change in this repo follows the kit: branch, verify.sh, independent review,
PR, hands-on check with screenshots or a transcript in work/<slug>/evidence/, then
./scripts/merge.sh. Never merge blind; gh pr merge is blocked.
EOF
  exit 0
fi

# ------------------------------------------------- opt in: wire the global auto-adopt
if [ "$MODE" = "enable-auto-adopt" ]; then
  S="$HOME/.claude/settings.json"; mkdir -p "$HOME/.claude"; [ -f "$S" ] || echo '{}' > "$S"
  cp "$S" "$S.bak-kit" 2>/dev/null || true
  python3 -I - "$S" "$KIT_HOME/bin/newproject" <<'PY'
import json, sys
path, np = sys.argv[1], sys.argv[2]
d = json.load(open(path))
cmd = f'"{np}" --adopt-hook'
groups = d.setdefault("hooks", {}).setdefault("SessionStart", [])
if not any("--adopt-hook" in h.get("command", "") for g in groups for h in g.get("hooks", [])):
    groups.append({"hooks": [{"type": "command", "command": cmd}]})
with open(path, "w") as f:
    json.dump(d, f, indent=2); f.write("\n")
PY
  echo "auto-adopt on: code repos under $BASE adopt the kit the first time Claude starts in them"
  echo "  hook added to $S (backup: $S.bak-kit)"
  echo "  opt one repo out: touch .claude/NO_KIT    turn off everywhere: CLAUDE_KIT_NO_AUTO_ADOPT=1"
  exit 0
fi

# --------------------------------------------------------------- update a project
if [ "$MODE" = "update" ]; then
  [ -d .claude ] || { echo "newproject --update: run this inside a project created by the kit" >&2; exit 1; }
  [ -d "$KIT_HOME/template" ] || { echo "newproject: template not found at $KIT_HOME/template" >&2; exit 1; }

  [ "$QUIET" = 1 ] || self_update auto
  FROM=$(cat .claude/KIT_VERSION 2>/dev/null || echo "unknown")
  TO=$(kit_version)

  # Only the kit's own machinery is refreshed, and only the pieces the kit ships.
  # Your own skills, agents, hooks and settings stay. Anything /kickoff writes or you
  # edit is left alone: CLAUDE.md, docs/, work/, IDEA.md, scripts/verify.sh, and
  # .github/workflows/verify.yml all keep your project's version.
  for d in skills agents hooks; do
    mkdir -p ".claude/$d"
    for src in "$KIT_HOME/template/.claude/$d"/*; do
      [ -e "$src" ] || continue
      n=$(basename "$src")
      rm -rf ".claude/$d/$n"
      cp -R "$src" ".claude/$d/$n"
    done
  done

  # settings.json is merged, not replaced: the kit's keys win, yours are kept.
  # `ask` rules are dropped — the kit never shows a permission prompt.
  if [ ! -f .claude/settings.json ]; then
    cp "$KIT_HOME/template/.claude/settings.json" .claude/settings.json
  elif command -v python3 >/dev/null 2>&1; then
    python3 -I - "$KIT_HOME/template/.claude/settings.json" .claude/settings.json <<'PY'
import json, sys
kit = json.load(open(sys.argv[1]))
path = sys.argv[2]
proj = json.load(open(path))
import os
KIT_HOOKS = [".claude/hooks/" + n for n in os.listdir(os.path.join(os.path.dirname(sys.argv[1]), "hooks"))]
for key, val in kit.items():
    if key == "permissions":
        perms = proj.setdefault("permissions", {})
        perms.update(val)
        perms.pop("ask", None)
    elif key == "env":
        proj.setdefault("env", {}).update(val)
    elif key == "hooks":
        hooks = proj.setdefault("hooks", {})
        for event, groups in val.items():
            yours = [g for g in hooks.get(event, [])
                     if not any(k in h.get("command", "") for k in KIT_HOOKS for h in g.get("hooks", []))]
            hooks[event] = yours + groups
    else:
        proj[key] = val
with open(path, "w") as f:
    json.dump(proj, f, indent=2)
    f.write("\n")
PY
  else
    echo "newproject: python3 not found — .claude/settings.json was not merged" >&2
  fi

  mkdir -p scripts
  for s in check-config.sh tag-release.sh ship-loop.sh merge.sh; do
    cp "$KIT_HOME/template/scripts/$s" "scripts/$s" 2>/dev/null || true
  done
  chmod +x scripts/*.sh .claude/hooks/*.sh 2>/dev/null || true
  # Loop runtime state must never be committed.
  for p in work/.shipping work/.ship-loop.log work/BLOCKED.md; do
    grep -qxF "$p" .gitignore 2>/dev/null || echo "$p" >> .gitignore
  done
  echo "$TO" > .claude/KIT_VERSION

  [ "$QUIET" = 1 ] && exit 0
  echo "updated $FROM -> $TO"
  echo "  refreshed: the kit's skills, agents and hooks; settings.json (merged);"
  echo "             scripts/check-config.sh, tag-release.sh, ship-loop.sh, merge.sh"
  echo "  kept:      your own skills, agents, hooks and settings"
  echo "  untouched: CLAUDE.md, docs/, work/, IDEA.md, scripts/verify.sh, .github/workflows/"
  exit 0
fi

# --------------------------------------------------------------------- create
self_update auto
[ -n "$NAME" ] || { echo "usage: newproject <name> [--here] [--dir <path>] [--no-open]" >&2; exit 2; }
[ -d "$KIT_HOME/template" ] || {
  echo "newproject: template not found at $KIT_HOME/template" >&2
  echo "  set CLAUDE_KIT_HOME, or re-run the kit's install.sh" >&2
  exit 1; }

if [ "$HERE" -eq 1 ]; then DEST="$PWD"; else DEST="$BASE/$NAME"; fi
if [ -e "$DEST" ] && [ "$HERE" -eq 0 ]; then
  echo "newproject: $DEST already exists" >&2; exit 1
fi

mkdir -p "$DEST"
cd "$DEST"

cp -R "$KIT_HOME/template/." .
chmod +x scripts/*.sh .claude/hooks/*.sh 2>/dev/null || true
kit_version > .claude/KIT_VERSION

if [ -f CLAUDE.md ]; then
  sed '1s|^# Project instructions$|# '"$NAME"'|' CLAUDE.md > CLAUDE.md.tmp && mv CLAUDE.md.tmp CLAUDE.md
fi

# The scaffold commit happens here, in plain shell, before any agent runs.
if [ ! -d .git ]; then
  git init -b main -q
  git add -A
  git commit -q -m "chore: initialize project from claude-agentic-workflow-starter-kit"
fi

echo "created $DEST"
echo
echo "  claude will ask you for the idea, then /kickoff takes it from there."
echo

[ "$OPEN" = 1 ] || exit 0
command -v claude >/dev/null 2>&1 || { echo "claude not on PATH; open it yourself and run /kickoff."; exit 0; }
CLAUDE_CODE_EVEN_MORE_DANGEROUSLY_SKIP_PERMISSIONS=1 exec claude "This is a brand new, empty project. There is no IDEA.md yet and nothing has been described to you. Your first message must ask me to describe the project I want to build: what it is, who it is for, and anything I already know about scope or stack. Ask that and nothing else, then wait. Do not read files, do not explore, do not plan, do not run /kickoff yet. When I answer, write what I said verbatim into IDEA.md, then run /kickoff."
